# Vision provider configuration
# Change these values to select your inference provider and vision-capable model.
# The client expects an OpenAI-style /chat/completions endpoint that accepts
# mixed text + image_url message content.
VISION_API_KEY=your_key_here
VISION_BASE_URL=https://your-provider.example/v1
VISION_MODEL=your-vision-model
VISION_TEMPERATURE=0.3
VISION_MAX_TOKENS=2000
VISION_TIMEOUT_MS=60000

# Concrete provider example. Uncomment and adapt if you use nanoGPT subscription + Minimax.
# VISION_BASE_URL=https://nano-gpt.com/api/subscription/v1
# VISION_MODEL=minimax/minimax-m3

# Optional provider label used only in safe logs and error messages.
VISION_PROVIDER_NAME=vision provider

# Local image safety
# By default, images are accepted from the project directory, the app temp dir,
# the screenshot output dir and the OS temp dir.
# Set this to a comma-separated allowlist when you need additional folders.
ALLOWED_IMAGE_DIRS=
MAX_IMAGES_PER_REQUEST=8
MAX_IMAGE_BYTES=10485760

# Screenshot storage
# Empty SCREENSHOT_OUTPUT_DIR means: <OS temp dir>/web-perception-mcp
# Examples:
# - macOS/Linux: /tmp/web-perception-mcp
# - Windows: C:\Users\<you>\AppData\Local\Temp\web-perception-mcp
SCREENSHOT_OUTPUT_DIR=
SCREENSHOT_AUTO_CLEANUP=true
SCREENSHOT_RETENTION_MINUTES=1440

# URL / browser security for webpage screenshots
# Leave ALLOWED_DOMAINS empty to allow arbitrary public web domains.
# Set it to a comma-separated allowlist for safer deployments, e.g. example.com,docs.example.com
ALLOWED_DOMAINS=
BLOCKED_DOMAINS=

# Local development escape hatch. Keep false unless you explicitly need to capture localhost.
ALLOW_LOCALHOST=false

# Backwards compatibility: older provider-specific variable aliases may still be accepted by the code.
# New configurations should use VISION_*.
